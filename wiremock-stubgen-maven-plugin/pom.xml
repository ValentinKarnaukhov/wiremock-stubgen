<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.valentinkarnaukhov</groupId>
        <artifactId>wiremock-stubgen-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>wiremock-stubgen-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>wiremock-stubgen-maven-plugin</name>
    <description>
        Maven delivery for wiremock-stubgen. Thin wrapper: reads configuration and
        delegates to the core and the selected language target.
    </description>

    <prerequisites>
        <maven>3.6.3</maven>
    </prerequisites>

    <dependencies>
        <dependency>
            <groupId>io.github.valentinkarnaukhov</groupId>
            <artifactId>wiremock-stubgen-core</artifactId>
        </dependency>
        <!--
            The Java target ships with the plugin so the default case needs no extra
            configuration. Further languages are added by declaring them as plugin
            dependencies; discovery happens through ServiceLoader.
        -->
        <dependency>
            <groupId>io.github.valentinkarnaukhov</groupId>
            <artifactId>wiremock-stubgen-codegen-java</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-tools.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- The specification the mojo is pointed at in tests. -->
        <dependency>
            <groupId>io.github.valentinkarnaukhov</groupId>
            <artifactId>wiremock-stubgen-fixtures</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>wiremock-stubgen</goalPrefix>
                </configuration>
            </plugin>
            <!-- Measured on 2026-09-01 at 95.5% instruction / 100% branch. See core's
                 pom for why the enforced numbers sit a little below that. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
