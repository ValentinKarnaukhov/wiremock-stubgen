<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.valentinkarnaukhov</groupId>
        <artifactId>wiremock-stubgen-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>wiremock-stubgen-runtime-java</artifactId>
    <name>wiremock-stubgen-runtime-java</name>
    <description>
        Hand-written runtime support for generated Java stub builders. Lives on the
        consumer's test classpath, so generated sources stay thin.

        This is a published API: generated code -- and therefore the consumer's own code --
        compiles against these classes, so they carry a compatibility obligation the
        generator itself does not. Nothing that only matters at generate time belongs here.
    </description>

    <dependencies>
        <!--
            Deliberately 'provided': the consumer supplies WireMock. This keeps us out of
            their version decision and allows drop-in replacement with a patched or
            internally forked WireMock build.
        -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            Also deliberately 'provided', for the same reason: BodySerializer.of(ObjectMapper)
            takes the consumer's own mapper, which means the consumer's own Jackson, not a
            version we would otherwise bundle and could disagree with.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Measured on 2026-09-01 at 100% instruction / 96.2% branch, after closing
                 this module's own coverage gaps. See core's pom for why the enforced
                 numbers sit a little below that. The one branch left uncovered is
                 defensive code in ReadOnlyProperties that no real class hierarchy can
                 reach, not a gap. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.95</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
