# Build output. Anchored to the repository root and to module roots on purpose:
# a bare "target/" would also swallow the source package stubgen/target/, and a
# new class dropped there would be ignored without a word.
/target/
/*/target/
/build/
/*/build/
!.mvn/wrapper/maven-wrapper.jar

.idea/
*.iml
*.ipr
*.iws
.vscode/

.DS_Store
*.log

# Local working notes: never committed, contents may reference internal sources
/tmp/
